{
  "name": "avhishek-credit-cards",
  "private": true,
  "scripts": {
    "dev": "node preview-server.mjs",
    "build:updates": "node scripts/updates/build.mjs",
    "check:updates": "node scripts/updates/build.mjs --check",
    "preview:updates": "node scripts/updates/build.mjs --preview && PREVIEW_ROOT=.preview node preview-server.mjs",
    "test:updates": "node --test scripts/updates/updates.test.mjs",
    "test:emi": "node --test scripts/emi/emi.test.mjs",
    "build:reviews": "esbuild src/card-reviews-entry.tsx --bundle --format=esm --target=es2020 --jsx=automatic --minify --outfile=assets/card-reviews-react.js",
    "build:loan-donut": "esbuild src/loan-emi-donut-entry.tsx --bundle --format=esm --target=es2020 --jsx=automatic --minify --outfile=assets/loan-emi-donut.js",
    "build:tabs": "esbuild src/arc-tabs-entry.tsx --bundle --format=esm --target=es2020 --jsx=automatic --minify --outfile=assets/arc-tabs-app.js && node -e \"require('fs').renameSync('assets/arc-tabs-app.css','assets/arc-tabs.css')\" && esbuild src/arc-tabs-loader.js --format=esm --target=es2020 --minify --outfile=assets/arc-tabs.js",
    "build:glass": "esbuild src/glass-buttons-entry.ts --bundle --format=esm --target=es2020 --minify --outfile=assets/glass-buttons.js",
    "build:upi": "esbuild node_modules/qrcode-generator/dist/qrcode.js --minify --banner:js=\"/*! qrcode-generator 2.0.4 (c) 2009 Kazuhiko Arase, MIT license */\" --outfile=assets/qrcode.js && node scripts/upi/bake.mjs",
    "check:upi": "node scripts/upi/bake.mjs --check",
    "build:search": "node scripts/search/build.mjs",
    "check:search": "node scripts/search/build.mjs --check",
    "build:og": "node scripts/og/build.mjs",
    "check:og": "node scripts/og/build.mjs --check"
  },
  "dependencies": {
    "@radix-ui/react-slot": "^1.5.0",
    "@radix-ui/react-tabs": "^1.2.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.545.0",
    "motion": "^12.23.24",
    "qrcode-generator": "2.0.4",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
