{
  "name": "avhishek-credit-cards",
  "private": true,
  "scripts": {
    "dev": "node preview-server.mjs",
    "build:updates": "node scripts/updates/build.mjs",
    "check:updates": "node scripts/updates/build.mjs --check",
    "preview:updates": "node scripts/updates/build.mjs --preview && PREVIEW_ROOT=.preview node preview-server.mjs",
    "test:updates": "node --test scripts/updates/updates.test.mjs",
    "test:emi": "node --test scripts/emi/emi.test.mjs",
    "build:reviews": "esbuild src/card-reviews-entry.tsx --bundle --format=esm --target=es2020 --jsx=automatic --minify --outfile=assets/card-reviews-react.js",
    "build:loan-donut": "esbuild src/loan-emi-donut-entry.tsx --bundle --format=esm --target=es2020 --jsx=automatic --minify --outfile=assets/loan-emi-donut.js"
  },
  "dependencies": {
    "lucide-react": "^0.545.0",
    "motion": "^12.23.24",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "esbuild": "^0.25.10",
    "typescript": "^5.9.3"
  }
}
