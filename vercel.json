{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/sitemap.xml",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/sitemap.xml",
      "permanent": true
    },
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/:path*",
      "permanent": true
    },
    {
      "source": "/coming-soon",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pay-bill",
      "destination": "/pay-credit-card-bill",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "/portfolio"
    },
    {
      "source": "/",
      "destination": "/home"
    },
    {
      "source": "/bank-support",
      "destination": "/support"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        }
      ]
    }
  ]
}
