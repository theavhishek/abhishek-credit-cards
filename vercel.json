{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "cleanUrls": true,
  "trailingSlash": false,
  "redirects": [
    {
      "source": "/:path*",
      "has": [
        {
          "type": "host",
          "value": "www\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/:path*",
      "permanent": true
    },
    {
      "source": "/home",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/",
      "permanent": true
    },
    {
      "source": "/support",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/bank-support",
      "permanent": true
    },
    {
      "source": "/bank-support",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/bank-support",
      "permanent": true
    },
    {
      "source": "/card-reviews",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/card-reviews",
      "permanent": true
    },
    {
      "source": "/card-reviews/:slug",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/card-reviews/:slug",
      "permanent": true
    },
    {
      "source": "/pay-credit-card-bill",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/pay-credit-card-bill",
      "permanent": true
    },
    {
      "source": "/pay-bill",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/pay-credit-card-bill",
      "permanent": true
    },
    {
      "source": "/credit-card-upi-id",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/credit-card-upi-id",
      "permanent": true
    },
    {
      "source": "/qr-scanner",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/qr-scanner",
      "permanent": true
    },
    {
      "source": "/updates",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/updates",
      "permanent": true
    },
    {
      "source": "/updates/:path*",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/updates/:path*",
      "permanent": true
    },
    {
      "source": "/disclaimer",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "https://avhishek.in/disclaimer",
      "permanent": true
    },
    {
      "source": "/coming-soon",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/pay-bill",
      "destination": "/pay-credit-card-bill",
      "permanent": true
    },
    {
      "source": "/home",
      "destination": "/",
      "permanent": true
    },
    {
      "source": "/support",
      "destination": "/bank-support",
      "permanent": true
    },
    {
      "source": "/portfolio",
      "destination": "https://cards.avhishek.in/",
      "permanent": true
    }
  ],
  "rewrites": [
    {
      "source": "/",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "destination": "/portfolio"
    },
    {
      "source": "/",
      "destination": "/home"
    },
    {
      "source": "/bank-support",
      "destination": "/support"
    }
  ],
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=3600, must-revalidate"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.woff2",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    },
    {
      "source": "/assets/(.*)\\.(jpg|jpeg|png|webp|svg)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=604800, stale-while-revalidate=86400"
        }
      ]
    },
    {
      "source": "/(.*)",
      "headers": [
        {
          "key": "X-Content-Type-Options",
          "value": "nosniff"
        },
        {
          "key": "Referrer-Policy",
          "value": "strict-origin-when-cross-origin"
        },
        {
          "key": "X-Frame-Options",
          "value": "SAMEORIGIN"
        },
        {
          "key": "Content-Security-Policy",
          "value": "default-src 'self'; script-src 'self' 'unsafe-inline'; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self'; object-src 'none'; base-uri 'self'; form-action 'self'; frame-ancestors 'self'; upgrade-insecure-requests"
        }
      ]
    },
    {
      "source": "/((?!qr-scanner).*)",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        }
      ]
    },
    {
      "source": "/qr-scanner",
      "headers": [
        {
          "key": "Permissions-Policy",
          "value": "camera=(self), microphone=(), geolocation=(), payment=(), usb=(), browsing-topics=()"
        }
      ]
    }
  ],
  "routes": [
    {
      "src": "/sitemap\\.xml",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "dest": "/cards-sitemap.xml"
    },
    {
      "src": "/robots\\.txt",
      "has": [
        {
          "type": "host",
          "value": "cards\\.avhishek\\.in"
        }
      ],
      "dest": "/cards-robots.txt"
    }
  ]
}
